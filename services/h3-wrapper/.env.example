# --- upstream: one wrapper per SGLang instance -------------------------------
SGLANG_BASE_URL=http://127.0.0.1:30000
SGLANG_MODEL=MiniMaxAI/MiniMax-H3
# Must match the --model-variant this SGLang instance was launched with.
# Both gameplay instances should be fl2va (DESIGN.md section 3.4).
SGLANG_VARIANT=fl2va
REQUEST_TIMEOUT_S=600
POLL_INTERVAL_S=0.25

# A GPU slot is serial. Only raise after benchmarking proves in-flight
# batching helps (P0 checklist item 5).
MAX_CONCURRENT=1

# --- local serving -----------------------------------------------------------
# nginx must serve CLIPS_DIR at PUBLIC_BASE_URL.
CLIPS_DIR=/var/www/clips
PUBLIC_BASE_URL=https://clips.example.com/clips
WORK_DIR=/tmp/h3-wrapper

# --- async archival (leave S3_BUCKET empty to disable) -----------------------
S3_BUCKET=
S3_PREFIX=kunlun/clips

# --- debugging ---------------------------------------------------------------
# Echo the untouched SGLang response on every /generate. Keep on during P0.
ECHO_RAW=true

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
