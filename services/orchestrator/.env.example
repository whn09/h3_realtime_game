# ---------------------------------------------------------------------------
# GPU pool
# ---------------------------------------------------------------------------
# `h3`     -- the live SGLang Diffusion deployment, reached through the ssh
#             tunnels game_tunnel.sh opens. This is the real one.
# `wrapper`-- via h3-wrapper, which does not exist yet.
# `fake`   -- synthesise clips locally with ffmpeg.
GPU_BACKEND=h3

# Only read when GPU_BACKEND=h3, and normally left empty: the backend then reads
# the replica file game_tunnel.sh wrote. Set it explicitly as `alias=host:port`
# pairs if you are not using that script. The ssh *alias* is load-bearing and a
# bare URL is not enough -- the API moves no bytes, so the conditioning frame
# goes up and the clip comes back over ssh to that alias.
H3_REPLICAS=
# Where game_tunnel.sh keeps the replica file and the ControlMaster sockets.
# Defaults to $TMPDIR/h3game, which is the same default the script uses, so
# leaving this unset is correct on the machine running the tunnels.
H3_STATE_DIR=
# Instance store on the box. Wiped on stop/start, which is fine -- everything
# written there is reproducible.
H3_REMOTE_OUT=/opt/dlami/nvme/vdn/outputs
# Transcribed from the deployed server's flags. Changing either changes the
# picture, so they are settings rather than literals.
H3_FLOW_SHIFT=12.0
H3_AUDIO_FLOW_SHIFT=3.0
H3_POLL_S=0.2
H3_FPS=24
# One throwaway clip per replica at startup: the server warms 768p regardless of
# --warmup-resolutions, so without this the first clip a player waits for pays
# ~0.9s of shape change. Costs ~8s per replica and runs in the background.
H3_WARM=1
H3_SSH_TIMEOUT_S=120

# Develop without a GPU: clips are synthesised locally with ffmpeg, but they go
# through the same slot accounting and the same last-frame extraction, so the
# whole story engine is exercised. Overrides GPU_BACKEND when set.
FAKE_GPU=0
FAKE_GPU_LATENCY_S=2.0
GPU_TIMEOUT_S=900
GPU_COOLDOWN_S=30

# One URL per h3-wrapper, only read when GPU_BACKEND=wrapper.
WRAPPER_URLS=http://127.0.0.1:8000,http://127.0.0.1:8001

# ---------------------------------------------------------------------------
# Beat shape
# ---------------------------------------------------------------------------
# 14.375s = 345 frames at 24fps. Frame counts live on a `5 + 17k` lattice (the
# VAE folds 17 frames into 5 latents) and anything off it is silently rounded by
# the server, so pick a value that lands on a rung: 10.125 (243f), 13.667 (328f),
# 14.375 (345f), 15.083 (362f). gpu.frames_for_seconds snaps before sending.
BEAT_SECONDS=14.375
SHORT_EDGE=480
ASPECT_RATIO=16:9
QUALITY=high
# 0 means "do not send it", which is the correct default on VDN-H3: the
# checkpoint is a Stage-DMD distill baked to exactly nine sigma grid points
# (eight DiT forwards) and the server rejects every other value outright. The
# step count is a property of the weights, not a knob this side owns.
NUM_INFERENCE_STEPS=0
# Degraded retry after a failed generation. On this deployment clip length is the
# only honest latency knob, for the reason directly above: 10.125s = 243 frames,
# the next lattice rung down, at 0.72x the tokens. Only the `fake` backend
# retries degraded at all -- a real rejection is a configuration error, and
# retrying it with different parameters just produces a different configuration
# error 8 seconds later.
RETRY_STEPS=0
RETRY_SECONDS=10.125

# ---------------------------------------------------------------------------
# Pre-generation
# ---------------------------------------------------------------------------
# 1 = both children of the watched beat. 2 = also the predicted grandchildren,
# which doubles the hiding window and needs 2 more slots.
PREGEN_DEPTH=1
BRANCH_COUNT=2
# Forced re-anchoring cut interval, independent of measured drift. Still a
# placeholder until bench/chain_drift.py measures the real K.
REANCHOR_EVERY=6
RESUMMARISE_EVERY=8

# ---------------------------------------------------------------------------
# Bedrock -- text
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
# CONFIRM these IDs against the account's model access before the first run;
# an unavailable model fails at call time, not at startup.
MODEL_WORLDSMITH=anthropic.claude-sonnet-5
MODEL_DIRECTOR=anthropic.claude-sonnet-5
MODEL_PROMPTIR=anthropic.claude-haiku-4-5
WORLDSMITH_THINKING=0
LLM_MAX_RETRIES=1
LLM_TIMEOUT_S=120

# ---------------------------------------------------------------------------
# PromptIR
# ---------------------------------------------------------------------------
# Generate only the visual description and template the soundscape/music from
# the world bible: ~40% less decode, and a byte-identical music line every beat
# so the score does not audibly restart at each join.
IR_TEMPLATE_TAIL=1
IR_MAX_REPAIRS=1
IR_MAX_TOKENS=1600

# ---------------------------------------------------------------------------
# Bedrock -- images (keyframes)
# ---------------------------------------------------------------------------
# SD3.5 Large, picked by measurement against the alternatives actually granted
# on this account: the most faithful to the prompt and the fastest at ~7.6s.
# `amazon.nova-canvas-v1:0` is marked LEGACY and answers InvokeModel with
# `Access denied ... not been actively using the model`; keyframe.py still knows
# its request shape in case that changes.
KEYFRAME_MODEL=stability.sd3-5-large-v1:0
# Its own region, because image and text access are not granted together: the
# only ACTIVE on-demand text-to-image models here are in us-west-2 while the
# text models are called in us-east-1.
KEYFRAME_REGION=us-west-2
# Only read by the Nova request shape; Stability models take ASPECT_RATIO and
# choose their own pixel dimensions (SD3.5 answers 16:9 with 1344x768). Either
# is fine -- H3 resizes the conditioning frame anyway.
KEYFRAME_WIDTH=1280
KEYFRAME_HEIGHT=720
# Synthesise a gradient placeholder if the image model is unavailable. The story
# must always be able to start. Worth turning OFF while developing: a silent
# fallback to a gradient is hard to spot and poisons every drift measurement
# downstream.
KEYFRAME_FALLBACK=1

# ---------------------------------------------------------------------------
# Storage / serving
# ---------------------------------------------------------------------------
DATA_DIR=./data
ASSETS_DIR=./data/assets
# Must match however /assets is actually reachable from the browser. In
# development that is this process; in production it is nginx + CDN. The real
# backend returns a path on the GPU box and has no download endpoint, so clips
# are copied here and served from here.
PUBLIC_BASE_URL=http://127.0.0.1:8100/assets
CORS_ORIGINS=http://localhost:3000

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
LOG_LEVEL=INFO
