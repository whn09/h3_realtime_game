# The orchestrator. Video and keyframe URLs are absolute and come from the API
# itself, so this only needs to point at the HTTP surface.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8100

# How long *before* the clip ends the two options appear, in seconds. Raised
# early rather than after so the clip's own picture and audio keep running
# underneath -- see the comment in components/Player.tsx. This is a head start on
# reading the cards, not a time limit.
NEXT_PUBLIC_DECISION_LEAD=4

# Seconds to wait after the clip ends before choosing for the player. 0 = never:
# the last frame holds and nothing is decided until they decide. That is the
# default, because both branches are already generated by then, so holding costs
# no GPU time -- and a 4s deadline mostly succeeded at taking the choice away
# from anyone still reading. Set it to e.g. 12 for an unattended demo loop.
NEXT_PUBLIC_AUTO_ADVANCE=0
